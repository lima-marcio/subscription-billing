# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=subscriptionbilling

# API
ASPNETCORE_ENVIRONMENT=Development

# JWT signing key - use a long random string (32+ chars)
JWT_KEY=replace-with-a-long-random-secret

# Admin login used by the /api/auth/login endpoint
ADMIN_USERNAME=admin
# Generate with: SubscriptionBilling.Api.Infrastructure.Security.PasswordHasher.Hash("your-password")
ADMIN_PASSWORD_HASH=replace-with-a-generated-hash

# Frontend origin allowed by CORS
CORS_ALLOWED_ORIGIN=http://localhost:5173
